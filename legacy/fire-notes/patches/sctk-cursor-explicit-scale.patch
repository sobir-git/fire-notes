+    /// Set the cursor using an explicit scale factor, bypassing cursor-shape
+    /// protocol and the cursor surface's own scale_factor() which may be stale.
+    /// This ensures the correct physical-pixel cursor image is loaded.
+    pub fn set_cursor_explicit_scale(
+        &self,
+        conn: &Connection,
+        icon: CursorIcon,
+        explicit_scale: i32,
+    ) -> Result<(), PointerThemeError> {
+        let serial = match self
+            .pointer
+            .data::<U>()
+            .and_then(|data| data.pointer_data().latest_enter_serial())
+        {
+            Some(serial) => serial,
+            None => return Err(PointerThemeError::MissingEnterSerial),
+        };
+        self.set_cursor_legacy_scaled(conn, serial, icon, explicit_scale)
+    }
